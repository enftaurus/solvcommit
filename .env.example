# ==============================================================================
# SolvCommit Production Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and replace placeholders with production secrets.
# DO NOT commit the resulting .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Settings
# ------------------------------------------------------------------------------
APP_ENV=production
PUBLIC_URL=https://solvcommit.eterno.software
FRONTEND_DOMAIN=solvcommit.eterno.software
API_DOMAIN=api.solvcommit.eterno.software

# Caddy TLS & Email (Used for Let's Encrypt certificate issuance)
CADDY_EMAIL=admin@solvcommit.dev

# Host HTTP/HTTPS ports published by Caddy (Defaults: 80 and 443)
HTTP_PORT=80
HTTPS_PORT=443

# (For local testing of compose.prod.yaml without public DNS, uncomment:)
# CADDY_GLOBAL_OPTIONS="auto_https off"
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# 2. Web Session Security
# ------------------------------------------------------------------------------
# REQUIRED: High-entropy secret key for HMAC session cookie signing.
# Generate with: openssl rand -hex 32 (Must be at least 32 bytes)
SESSION_SECRET=generate-a-strong-random-32-byte-hex-string-here

# Ingestion limits (Default: 262144 = 256 KB)
MAX_CODE_BYTES=262144

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
# Internal credentials for the postgres container
POSTGRES_USER=leetsync
POSTGRES_PASSWORD=generate-strong-db-password-here
POSTGRES_DB=leetsync

# ------------------------------------------------------------------------------
# 4. Apache Kafka
# ------------------------------------------------------------------------------
KAFKA_TOPIC_SUBMISSIONS=submissions

# ------------------------------------------------------------------------------
# 5. GitHub App Configuration (Required for OAuth & automated git commits)
# ------------------------------------------------------------------------------
GITHUB_APP_SLUG=solvcommit
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
GITHUB_APP_CLIENT_SECRET=github_client_secret_here

# Path to the GitHub App RSA Private Key PEM file inside container
GITHUB_APP_PRIVATE_KEY_PATH=/app/github-app.pem

# Host path to GitHub App PEM file to mount into container
# e.g., /home/azureuser/solvcommit/github-app.pem
GITHUB_APP_PRIVATE_KEY_FILE=/dev/null

# Production GitHub OAuth callback URL configured in GitHub App settings:
GITHUB_CALLBACK_URL=https://solvcommit.eterno.software/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# 6. Support & Transactional Email
# ------------------------------------------------------------------------------
SUPPORT_EMAIL=valyrianminds@zohomail.in
EMAIL_FROM=noreply@solvcommit.dev
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=valyrianminds@zohomail.in
SMTP_PASS=
