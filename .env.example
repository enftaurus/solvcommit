# Application Environment
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://leetsync:change-me@localhost:5432/leetsync?sslmode=disable
POSTGRES_USER=leetsync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leetsync
POSTGRES_PORT=5432

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SUBMISSIONS=submissions
KAFKA_PORT=9092

# GitHub App (Phase 2+)
GITHUB_APP_SLUG=solvcommit
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# Web Session Secret
SESSION_SECRET=dev-session-secret-at-least-32-bytes-long

# Ingestion limits (256 KB)
MAX_CODE_BYTES=262144

# Support & Transactional Email
SUPPORT_EMAIL=valyrianminds@zohomail.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@solvcommit.dev
